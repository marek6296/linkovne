{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "buffer_linkovne": {
      "type": "streamable-http",
      "url": "https://mcp.buffer.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "account:read"
            ],
            "defaultScopes": [
              "offline_access",
              "posts:read",
              "posts:write",
              "ideas:read",
              "ideas:write",
              "insights:read",
              "snippets:read",
              "snippets:write"
            ]
          }
        }
      }
    }
  }
}
